{
  "name": "yosseuf-os-cloud",
  "version": "3.0.3",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate:foundation": "node scripts/validate-foundation.mjs",
    "validate:a11y": "node scripts/validate-accessibility.mjs",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "quality": "npm run check:release && npm run validate:foundation && npm run validate:a11y && npm run lint && npm run typecheck && npm test && npm run build && npm run analyze:bundle",
    "mobile:install": "npm --prefix mobile install",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:doctor": "npm --prefix mobile run doctor",
    "quality:mobile": "npm run mobile:typecheck && npm run mobile:doctor",
    "quality:all": "npm run quality && npm run quality:mobile",
    "check:release": "node scripts/check-release-consistency.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "0.468.0",
    "next": "^16.2.12",
    "react": "^19.2.2",
    "react-dom": "^19.2.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "typescript": "5.7.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  }
}
