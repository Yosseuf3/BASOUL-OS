{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
      "bindings": [
        {
          "type": "service",
          "service": "cad_gateway",
          "format": "url",
          "env": "CAD_GATEWAY_URL"
        }
      ]
    },
    "cad_gateway": {
      "root": "tools/cad-ingestion",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel",
      "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
